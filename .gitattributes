# Keep dev-only artifacts out of release archives (git archive / Cloudflare Pages deploy).
# export-ignore affects `git archive` only — these files still live on GitHub.
tests/          export-ignore
.github/        export-ignore
docs/           export-ignore
pkg/            export-ignore
audit-output/   export-ignore
archive/        export-ignore
# capture files are the wide-area archive: git-tracked for durability, never published
# (the client and the CalTopo export read the display-scoped snapshots; history and crest
# read the capture and apply display scope themselves, at publish time)
data/gauges-capture.json export-ignore
data/roads-capture.json  export-ignore
.gitattributes  export-ignore
assets/architecture.svg export-ignore
workers/        export-ignore
